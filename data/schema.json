[
  {
    "kind": "folder",
    "name": "posts",
    "label": "Posts",
    "labelSingular": "Post",
    "folder": "content/posts",
    "body": "rich",
    "localized": true,
    "thumbnail": "featuredImage",
    "fields": [
      {
        "name": "title",
        "label": "Title",
        "widget": "string"
      },
      {
        "name": "seo",
        "label": "SEO",
        "widget": "object",
        "required": false,
        "collapsed": true,
        "fields": [
          {
            "name": "metaTitle",
            "label": "Meta title (overrides title)",
            "widget": "string",
